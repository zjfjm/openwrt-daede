+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026 daeuniverse Organization <dae@v2raya.org>
+ */
+
+// Package masque implements the Cloudflare WARP MASQUE outbound: one shared
+// HTTP/3 connection to a WARP entry point, with every proxied TCP connection
+// carried on its own HTTP/3 CONNECT stream (usque's L4 mode).
+package masque
+
+import (
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"fmt"
+	"net"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+
+	"github.com/daeuniverse/outbound/dialer"
+	"github.com/daeuniverse/outbound/netproxy"
+)
+
+func init() {
+	dialer.FromLinkRegister("masque", NewMasque)
+}
+
+const (
+	// DefaultSNI is the certificate name Cloudflare's consumer MASQUE
+	// endpoints present; L4 mode always connects with this SNI
+	// (usque internal.L4ConnectSNI).
+	DefaultSNI = "consumer-masque-proxy.cloudflareclient.com"
+
+	defaultConnectPort = 443
+)
+
+// Config is the subset of a WARP registration config.json required to open
+// an MASQUE session (usque's config.Config minus account metadata).
+type Config struct {
+	PrivateKey     string `json:"private_key"`      // Base64-encoded ECDSA private key
+	EndpointPubKey string `json:"endpoint_pub_key"` // PEM-encoded ECDSA public key of the endpoint
+	EndpointV4     string `json:"endpoint_v4"`      // IPv4 address of the entry point
+	EndpointV6     string `json:"endpoint_v6"`      // IPv6 address of the entry point
+	ID             string `json:"id,omitempty"`     // Device unique identifier
+	IPv4           string `json:"ipv4,omitempty"`   // Assigned IPv4 address
+	IPv6           string `json:"ipv6,omitempty"`   // Assigned IPv6 address
+}
+
+// Masque is a netproxy.Dialer that carries TCP connections through a
+// Cloudflare WARP MASQUE entry point over HTTP/3 CONNECT streams.
+type Masque struct {
+	name     string
+	link     string
+	endpoint string // host:port of the MASQUE entry point
+	cfg      Config
+	sni      string
+	insecure bool
+
+	mu     sync.Mutex
+	sess   *session
+	closed bool
+}
+
+// NewMasque is the dialer.FromLinkCreator for the "masque" scheme.
+//
+// The link format is:
+//
+//	masque://<endpoint-host>?cfg=<base64url(config.json)>&port=443&ipv6=0&insecure=0&sni=...#<name>
+//
+// Precedence for the entry point: endpoint= query, then the link host, then
+// endpoint_v4/endpoint_v6 from the embedded config (chosen by ipv6=).
+// The full registration config.json travels base64url-encoded in cfg= so the
+// link stays self-contained; keep the raw JSON key order untouched when
+// regenerating it so identical configs produce identical links.
+func NewMasque(option *dialer.ExtraOption, nextDialer netproxy.Dialer, link string) (netproxy.Dialer, *dialer.Property, error) {
+	allowInsecure := option != nil && option.AllowInsecure
+	s, err := ParseMasqueURL(link, allowInsecure)
+	if err != nil {
+		return nil, nil, err
+	}
+	return s, &dialer.Property{
+		Name:     s.name,
+		Address:  s.endpoint,
+		Protocol: "masque",
+		Link:     s.link,
+	}, nil
+}
+
+// ParseMasqueURL parses a masque:// link. allowInsecure comes from the
+// global ExtraOption and disables endpoint public-key pinning for the node.
+func ParseMasqueURL(link string, allowInsecure bool) (*Masque, error) {
+	idx := strings.Index(link, "://")
+	if idx <= 0 || !strings.EqualFold(link[:idx], "masque") {
+		return nil, fmt.Errorf("%w: not a masque link", dialer.InvalidParameterErr)
+	}
+	u, err := url.Parse(link)
+	if err != nil {
+		return nil, fmt.Errorf("%w: %v", dialer.InvalidParameterErr, err)
+	}
+	q := u.Query()
+
+	payload := q.Get("cfg")
+	if payload == "" {
+		return nil, fmt.Errorf("%w: missing cfg parameter", dialer.InvalidParameterErr)
+	}
+	raw, err := decodePayload(payload)
+	if err != nil {
+		return nil, fmt.Errorf("%w: cfg: %v", dialer.InvalidParameterErr, err)
+	}
+	var cfg Config
+	if err := json.Unmarshal(raw, &cfg); err != nil {
+		return nil, fmt.Errorf("%w: cfg: %v", dialer.InvalidParameterErr, err)
+	}
+	if _, _, err := parseKeys(&cfg); err != nil {
+		return nil, err
+	}
+
+	port := defaultConnectPort
+	if portStr := q.Get("port"); portStr != "" {
+		p, err := strconv.ParseUint(portStr, 10, 16)
+		if err != nil || p == 0 {
+			return nil, fmt.Errorf("%w: invalid port %q", dialer.InvalidParameterErr, portStr)
+		}
+		port = int(p)
+	}
+
+	host := q.Get("endpoint")
+	if host == "" {
+		host = u.Host
+	}
+	endpoint, err := selectEndpoint(host, cfg, isTruthy(q.Get("ipv6")), port)
+	if err != nil {
+		return nil, err
+	}
+
+	name := u.Fragment
+	if name == "" {
+		name = "masque"
+	}
+	sni := q.Get("sni")
+	if sni == "" {
+		sni = DefaultSNI
+	}
+
+	return &Masque{
+		name:     name,
+		link:     link,
+		endpoint: endpoint,
+		cfg:      cfg,
+		sni:      sni,
+		insecure: allowInsecure || dialer.AllowInsecureFromQuery(q),
+	}, nil
+}
+
+// selectEndpoint resolves the entry point into a host:port string.
+// An explicit host wins over the embedded config endpoints; a host that
+// already carries a port is used verbatim and port is ignored.
+func selectEndpoint(host string, cfg Config, useIPv6 bool, port int) (string, error) {
+	if host != "" {
+		// A bracketed IPv6 literal without a port ("[::1]") arrives from
+		// url.Host; trim the brackets so JoinHostPort does not double them.
+		if strings.HasPrefix(host, "[") && strings.HasSuffix(host, "]") {
+			host = strings.TrimSuffix(strings.TrimPrefix(host, "["), "]")
+		}
+		if ip := net.ParseIP(host); ip != nil {
+			return net.JoinHostPort(host, strconv.Itoa(port)), nil
+		}
+		if h, _, err := net.SplitHostPort(host); err == nil && h != "" {
+			return host, nil
+		}
+		return net.JoinHostPort(host, strconv.Itoa(port)), nil
+	}
+	if useIPv6 {
+		if cfg.EndpointV6 == "" {
+			return "", fmt.Errorf("%w: ipv6=1 but config has no endpoint_v6", dialer.InvalidParameterErr)
+		}
+		return net.JoinHostPort(cfg.EndpointV6, strconv.Itoa(port)), nil
+	}
+	if cfg.EndpointV4 == "" {
+		return "", fmt.Errorf("%w: config has no endpoint_v4", dialer.InvalidParameterErr)
+	}
+	return net.JoinHostPort(cfg.EndpointV4, strconv.Itoa(port)), nil
+}
+
+// DialContext opens target as a stream on the shared HTTP/3 connection.
+// UDP is not supported by the L4 MASQUE mode.
+func (m *Masque) DialContext(ctx context.Context, network, addr string) (netproxy.Conn, error) {
+	// dae may encode SO_MARK/MPTCP/IP-version into the network string
+	// (netproxy.MagicNetwork); parse it like every other dialer and dispatch
+	// on the underlying transport. Mark/Mptcp cannot be honored here: the
+	// outer TCP socket to the WARP edge is owned by the endpoint, which
+	// dials the target itself.
+	mn, err := netproxy.ParseMagicNetwork(network)
+	if err != nil {
+		return nil, err
+	}
+	switch mn.Network {
+	case "tcp", "tcp4", "tcp6":
+	case "udp", "udp4", "udp6":
+		return nil, netproxy.UnsupportedTunnelTypeError
+	default:
+		return nil, fmt.Errorf("%w: %v", netproxy.UnsupportedTunnelTypeError, mn.Network)
+	}
+	sess, err := m.getSession()
+	if err != nil {
+		return nil, err
+	}
+	return sess.DialContext(ctx, addr)
+}
+
+// getSession returns the shared session, establishing it on first use so
+// link import never dials the network.
+func (m *Masque) getSession() (*session, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.closed {
+		return nil, net.ErrClosed
+	}
+	if m.sess != nil {
+		return m.sess, nil
+	}
+	m.sess = m.newSession()
+	return m.sess, nil
+}
+
+// Close tears down the shared HTTP/3 session.
+func (m *Masque) Close() error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.closed = true
+	if m.sess != nil {
+		m.sess.close()
+		m.sess = nil
+	}
+	return nil
+}
+
+func decodePayload(s string) ([]byte, error) {
+	var firstErr error
+	for _, enc := range []*base64.Encoding{
+		base64.RawURLEncoding,
+		base64.RawStdEncoding,
+		base64.URLEncoding,
+		base64.StdEncoding,
+	} {
+		b, err := enc.DecodeString(s)
+		if err == nil {
+			return b, nil
+		}
+		if firstErr == nil {
+			firstErr = err
+		}
+	}
+	return nil, firstErr
+}
+
+func isTruthy(v string) bool {
+	if v == "" {
+		return false
+	}
+	b, err := strconv.ParseBool(v)
+	return err == nil && b
+}
