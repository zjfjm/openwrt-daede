+
+package masque
+
+import (
+	"crypto/ecdsa"
+	"crypto/rand"
+	"crypto/tls"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/pem"
+	"fmt"
+	"math/big"
+	"time"
+
+	"github.com/daeuniverse/outbound/dialer"
+	"github.com/olicesx/quic-go/http3"
+)
+
+// parseKeys decodes the WARP account ECDSA private key (base64 DER) and the
+// entry point public key (PEM PKIX) from the embedded registration config.
+func parseKeys(cfg *Config) (*ecdsa.PrivateKey, *ecdsa.PublicKey, error) {
+	if cfg.PrivateKey == "" {
+		return nil, nil, fmt.Errorf("%w: config has no private_key", dialer.InvalidParameterErr)
+	}
+	privDER, err := decodeOneOf(cfg.PrivateKey)
+	if err != nil {
+		return nil, nil, fmt.Errorf("%w: private_key: %v", dialer.InvalidParameterErr, err)
+	}
+	privKey, err := x509.ParseECPrivateKey(privDER)
+	if err != nil {
+		return nil, nil, fmt.Errorf("%w: private_key: %v", dialer.InvalidParameterErr, err)
+	}
+
+	if cfg.EndpointPubKey == "" {
+		return nil, nil, fmt.Errorf("%w: config has no endpoint_pub_key", dialer.InvalidParameterErr)
+	}
+	block, _ := pem.Decode([]byte(cfg.EndpointPubKey))
+	if block == nil {
+		return nil, nil, fmt.Errorf("%w: endpoint_pub_key is not PEM", dialer.InvalidParameterErr)
+	}
+	parsed, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, nil, fmt.Errorf("%w: endpoint_pub_key: %v", dialer.InvalidParameterErr, err)
+	}
+	peerPub, ok := parsed.(*ecdsa.PublicKey)
+	if !ok {
+		return nil, nil, fmt.Errorf("%w: endpoint_pub_key is not ECDSA", dialer.InvalidParameterErr)
+	}
+	return privKey, peerPub, nil
+}
+
+func decodeOneOf(s string) ([]byte, error) {
+	var firstErr error
+	for _, enc := range []*base64.Encoding{
+		base64.StdEncoding,
+		base64.RawStdEncoding,
+		base64.URLEncoding,
+		base64.RawURLEncoding,
+	} {
+		b, err := enc.DecodeString(s)
+		if err == nil {
+			return b, nil
+		}
+		if firstErr == nil {
+			firstErr = err
+		}
+	}
+	return nil, firstErr
+}
+
+// tlsConfig builds the client TLS configuration for one session. The client
+// certificate is regenerated per session: WARP certificates are minted with a
+// 24h validity, so a reconnect after that window must not reuse an expired
+// one (usque api.PrepareTlsConfig + internal.GenerateCert).
+func (m *Masque) tlsConfig() (*tls.Config, error) {
+	privKey, peerPub, err := parseKeys(&m.cfg)
+	if err != nil {
+		return nil, err
+	}
+	cert, err := generateCert(privKey)
+	if err != nil {
+		return nil, err
+	}
+	cfg := &tls.Config{
+		Certificates: []tls.Certificate{
+			{
+				Certificate: cert,
+				PrivateKey:  privKey,
+			},
+		},
+		ServerName: m.sni,
+		NextProtos: []string{http3.NextProtoH3},
+		// WARN: SNI is not the endpoint's own name; trust is established by
+		// pinning the endpoint public key from config.json instead.
+		InsecureSkipVerify: true,
+	}
+	if !m.insecure {
+		cfg.VerifyPeerCertificate = newPinnedVerifier(peerPub)
+	}
+	return cfg, nil
+}
+
+// newPinnedVerifier pins the peer leaf certificate to the entry point
+// public key carried in config.json (usque api.PrepareTlsConfig).
+func newPinnedVerifier(peerPub *ecdsa.PublicKey) func(rawCerts [][]byte, _ [][]*x509.Certificate) error {
+	return func(rawCerts [][]byte, _ [][]*x509.Certificate) error {
+		if len(rawCerts) == 0 {
+			return nil
+		}
+		cert, err := x509.ParseCertificate(rawCerts[0])
+		if err != nil {
+			return err
+		}
+		pub, ok := cert.PublicKey.(*ecdsa.PublicKey)
+		if !ok {
+			// Only ECDSA endpoints are supported today.
+			return x509.ErrUnsupportedAlgorithm
+		}
+		if !pub.Equal(peerPub) {
+			// Reason 10 is x509.CertificateInvalidReason NoValidChains,
+			// not defined before go1.22 in the stdlib alias we cannot use.
+			return x509.CertificateInvalidError{Cert: cert, Reason: 10, Detail: "remote endpoint has a different public key than endpoint_pub_key in cfg"}
+		}
+		return nil
+	}
+}
+
+// generateCert mints the short-lived client certificate WARP expects
+// (usque internal.GenerateCert).
+func generateCert(privKey *ecdsa.PrivateKey) ([][]byte, error) {
+	cert, err := x509.CreateCertificate(rand.Reader, &x509.Certificate{
+		SerialNumber: big.NewInt(0),
+		NotBefore:    time.Now(),
+		NotAfter:     time.Now().Add(24 * time.Hour),
+	}, &x509.Certificate{}, &privKey.PublicKey, privKey)
+	if err != nil {
+		return nil, err
+	}
+	return [][]byte{cert}, nil
+}
