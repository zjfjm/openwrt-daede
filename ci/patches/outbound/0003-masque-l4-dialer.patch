index 0000000..9e54d5e
--- /dev/null
+++ b/dialer/masque/session.go
@@ -0,0 +1,403 @@
+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026 daeuniverse Organization <dae@v2raya.org>
+ */
+
+package masque
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/olicesx/quic-go"
+	"github.com/olicesx/quic-go/http3"
+)
+
+const (
+	defaultConnectTimeout    = 15 * time.Second
+	defaultConnectRetryCount = 2
+)
+
+// session multiplexes every proxied TCP connection as one HTTP/3 CONNECT
+// stream over a single shared QUIC connection to the entry point
+// (usque api.L4Proxy).
+type session struct {
+	masque *Masque
+
+	mu     sync.Mutex
+	client *l4Client
+}
+
+type l4Client struct {
+	transport  *quic.Transport
+	udpConn    *net.UDPConn
+	quicConn   quic.Connection
+	clientConn *http3.ClientConn
+}
+
+func (m *Masque) newSession() *session {
+	return &session{masque: m}
+}
+
+// DialContext connects target over an L4 MASQUE HTTP/3 CONNECT stream.
+func (s *session) DialContext(ctx context.Context, target string) (net.Conn, error) {
+	// Cloudflare's L4 CONNECT requires an IP authority; resolve hostname
+	// targets locally (usque runs L4 with resolveLocally=true for the same
+	// reason). dae normally pre-resolves, so this is a fallback.
+	target, err := resolveTarget(ctx, target)
+	if err != nil {
+		return nil, err
+	}
+	var lastErr error
+	for attempt := 0; attempt < defaultConnectRetryCount; attempt++ {
+		dialCtx, cancel := context.WithTimeout(ctx, defaultConnectTimeout)
+		conn, err := s.dial(dialCtx, target)
+		cancel()
+		if err == nil {
+			return conn, nil
+		}
+		lastErr = err
+		if ctx.Err() != nil {
+			return nil, ctx.Err()
+		}
+	}
+	return nil, lastErr
+}
+
+func resolveTarget(ctx context.Context, target string) (string, error) {
+	host, port, err := net.SplitHostPort(target)
+	if err != nil {
+		return "", fmt.Errorf("invalid target %q: %w", target, err)
+	}
+	if net.ParseIP(host) != nil {
+		return target, nil
+	}
+	addrs, err := net.DefaultResolver.LookupIPAddr(ctx, host)
+	if err != nil {
+		return "", fmt.Errorf("resolve %s: %w", host, err)
+	}
+	if len(addrs) == 0 {
+		return "", fmt.Errorf("resolve %s: no addresses", host)
+	}
+	picked := addrs[0].IP
+	for _, a := range addrs {
+		if a.IP.To4() != nil {
+			picked = a.IP
+			break
+		}
+	}
+	return net.JoinHostPort(picked.String(), port), nil
+}
+
+func (s *session) dial(ctx context.Context, target string) (net.Conn, error) {
+	h3Client, err := s.getOrCreateClientConn(ctx)
+	if err != nil {
+		return nil, err
+	}
+
+	stream, err := h3Client.clientConn.OpenRequestStream(ctx)
+	if err != nil {
+		if !shouldReconnectOnOpenStreamError(ctx, err) {
+			return nil, err
+		}
+		// The cached HTTP/3 connection might be stale; reconnect once and retry.
+		s.closeClientConnIfCurrent(h3Client)
+		h3Client, err = s.getOrCreateClientConn(ctx)
+		if err != nil {
+			return nil, err
+		}
+		stream, err = h3Client.clientConn.OpenRequestStream(ctx)
+		if err != nil {
+			if shouldReconnectOnOpenStreamError(ctx, err) {
+				s.closeClientConnIfCurrent(h3Client)
+			}
+			return nil, err
+		}
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodConnect, "https://"+target, nil)
+	if err != nil {
+		_ = stream.Close()
+		return nil, err
+	}
+	req.Host = target
+	if err := stream.SendRequestHeader(req); err != nil {
+		_ = stream.Close()
+		return nil, err
+	}
+	response, err := stream.ReadResponse()
+	if err != nil {
+		_ = stream.Close()
+		return nil, err
+	}
+	if response.StatusCode < 200 || response.StatusCode > 299 {
+		_ = stream.Close()
+		return nil, fmt.Errorf("CONNECT rejected with status %d: %s",
+			response.StatusCode, describeRejectedResponse(response))
+	}
+	return &l4TCPConn{
+		stream: stream,
+		local:  h3Client.udpConn.LocalAddr(),
+		remote: targetAddr(target),
+	}, nil
+}
+
+// describeRejectedResponse renders response headers and body for a rejected
+// CONNECT so the edge's refusal reason is surfaced in probe errors.
+func describeRejectedResponse(response *http.Response) string {
+	var sb strings.Builder
+	for name, values := range response.Header {
+		for _, v := range values {
+			if sb.Len() > 512 {
+				break
+			}
+			sb.WriteString(name)
+			sb.WriteString(": ")
+			sb.WriteString(v)
+			sb.WriteString("; ")
+		}
+	}
+	if response.Body != nil {
+		body, _ := io.ReadAll(io.LimitReader(response.Body, 400))
+		_ = response.Body.Close()
+		if len(body) > 0 {
+			sb.WriteString("body=")
+			sb.WriteString(strings.TrimSpace(string(body)))
+		}
+	}
+	return sb.String()
+}
+
+// targetAddr renders the CONNECT authority as a native TCP address so
+// dae-side helpers that inspect RemoteAddr see a real IP and port.
+func targetAddr(target string) net.Addr {
+	if host, port, err := net.SplitHostPort(target); err == nil {
+		if ip := net.ParseIP(host); ip != nil {
+			if p, err := strconv.Atoi(port); err == nil {
+				return &net.TCPAddr{IP: ip, Port: p}
+			}
+		}
+	}
+	return l4Addr(target)
+}
+
+func shouldReconnectOnOpenStreamError(ctx context.Context, err error) bool {
+	if err == nil {
+		return false
+	}
+	if errors.Is(err, context.Canceled) || errors.Is(err, context.DeadlineExceeded) {
+		return false
+	}
+	if ctx != nil && (errors.Is(ctx.Err(), context.Canceled) || errors.Is(ctx.Err(), context.DeadlineExceeded)) {
+		return false
+	}
+	return true
+}
+
+func (s *session) getOrCreateClientConn(ctx context.Context) (*l4Client, error) {
+	s.mu.Lock()
+	if s.client != nil {
+		client := s.client
+		s.mu.Unlock()
+		return client, nil
+	}
+	s.mu.Unlock()
+
+	endpoint, err := net.ResolveUDPAddr("udp", s.masque.endpoint)
+	if err != nil {
+		return nil, fmt.Errorf("resolve masque endpoint: %w", err)
+	}
+	tlsConfig, err := s.masque.tlsConfig()
+	if err != nil {
+		return nil, err
+	}
+
+	udpConn, err := listenUDPForEndpoint(endpoint)
+	if err != nil {
+		return nil, err
+	}
+	// Without ConnectionIDLength set the backend occasionally throws
+	// PROTOCOL_VIOLATION, which closes the connection.
+	qtr := &quic.Transport{Conn: udpConn, ConnectionIDLength: 20}
+	quicConn, err := qtr.Dial(ctx, endpoint, tlsConfig, l4QUICConfig())
+	if err != nil {
+		_ = qtr.Close()
+		_ = udpConn.Close()
+		return nil, err
+	}
+
+	created := &l4Client{
+		transport:  qtr,
+		udpConn:    udpConn,
+		quicConn:   quicConn,
+		clientConn: (&http3.Transport{}).NewClientConn(quicConn),
+	}
+
+	s.mu.Lock()
+	if s.client != nil {
+		current := s.client
+		s.mu.Unlock()
+		closeL4HTTP3(created)
+		return current, nil
+	}
+	s.client = created
+	s.mu.Unlock()
+
+	return created, nil
+}
+
+func (s *session) closeClientConnIfCurrent(expected *l4Client) {
+	if expected == nil {
+		return
+	}
+
+	s.mu.Lock()
+	if s.client != expected {
+		s.mu.Unlock()
+		return
+	}
+	s.client = nil
+	s.mu.Unlock()
+
+	closeL4HTTP3(expected)
+}
+
+func (s *session) close() {
+	s.mu.Lock()
+	client := s.client
+	s.client = nil
+	s.mu.Unlock()
+	if client != nil {
+		closeL4HTTP3(client)
+	}
+}
+
+// l4QUICConfig mirrors usque's L4 QUIC settings: no datagrams (plain
+// CONNECT streams only), bounded windows, and a 30s keepalive.
+func l4QUICConfig() *quic.Config {
+	return &quic.Config{
+		EnableDatagrams:                false,
+		KeepAlivePeriod:                30 * time.Second,
+		InitialConnectionReceiveWindow: 10_000_000,
+		MaxConnectionReceiveWindow:     10_000_000,
+		InitialStreamReceiveWindow:     1_000_000,
+		MaxStreamReceiveWindow:         1_000_000,
+		MaxIncomingStreams:             100,
+		MaxIncomingUniStreams:          100,
+	}
+}
+
+func listenUDPForEndpoint(endpoint *net.UDPAddr) (*net.UDPConn, error) {
+	if endpoint.IP.To4() == nil {
+		return net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv6zero})
+	}
+	return net.ListenUDP("udp", &net.UDPAddr{IP: net.IPv4zero})
+}
+
+func closeL4HTTP3(c *l4Client) {
+	if c.quicConn != nil {
+		_ = c.quicConn.CloseWithError(0, "")
+	}
+	if c.transport != nil {
+		_ = c.transport.Close()
+	}
+	if c.udpConn != nil {
+		_ = c.udpConn.Close()
+	}
+}
+
+type l4TCPConn struct {
+	stream l4Stream
+	local  net.Addr
+	remote net.Addr
+	once   sync.Once
+}
+
+type l4Stream interface {
+	io.ReadWriteCloser
+	CancelRead(quic.StreamErrorCode)
+	SetDeadline(time.Time) error
+	SetReadDeadline(time.Time) error
+	SetWriteDeadline(time.Time) error
+}
+
+func (c *l4TCPConn) Read(b []byte) (int, error) {
+	if c.stream == nil {
+		return 0, net.ErrClosed
+	}
+	return c.stream.Read(b)
+}
+
+func (c *l4TCPConn) Write(b []byte) (int, error) {
+	if c.stream == nil {
+		return 0, net.ErrClosed
+	}
+	return c.stream.Write(b)
+}
+
+func (c *l4TCPConn) CloseWrite() error {
+	if c.stream == nil {
+		return nil
+	}
+	return c.stream.Close()
+}
+
+func (c *l4TCPConn) CloseRead() error {
+	if c.stream == nil {
+		return nil
+	}
+	c.stream.CancelRead(quic.StreamErrorCode(http3.ErrCodeNoError))
+	return nil
+}
+
+func (c *l4TCPConn) Close() error {
+	var err error
+	c.once.Do(func() {
+		err = c.CloseWrite()
+		_ = c.CloseRead()
+	})
+	return err
+}
+
+func (c *l4TCPConn) LocalAddr() net.Addr {
+	if c.local == nil {
+		return l4Addr("l4")
+	}
+	return c.local
+}
+
+func (c *l4TCPConn) RemoteAddr() net.Addr { return c.remote }
+
+func (c *l4TCPConn) SetDeadline(t time.Time) error {
+	if c.stream == nil {
+		return nil
+	}
+	return c.stream.SetDeadline(t)
+}
+
+func (c *l4TCPConn) SetReadDeadline(t time.Time) error {
+	if c.stream == nil {
+		return nil
+	}
+	return c.stream.SetReadDeadline(t)
+}
+
+func (c *l4TCPConn) SetWriteDeadline(t time.Time) error {
+	if c.stream == nil {
+		return nil
+	}
+	return c.stream.SetWriteDeadline(t)
+}
+
+type l4Addr string
+
+func (a l4Addr) Network() string { return "masque-l4-tcp" }
+func (a l4Addr) String() string  { return string(a) }
