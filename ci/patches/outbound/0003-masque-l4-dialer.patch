+/*
+ * SPDX-License-Identifier: AGPL-3.0-only
+ * Copyright (c) 2026 daeuniverse Organization <dae@v2raya.org>
+ */
+
+package masque
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"net"
+	"strings"
+	"testing"
+
+	"github.com/daeuniverse/outbound/dialer"
+	"github.com/daeuniverse/outbound/netproxy"
+)
+
+type nopDialer struct{}
+
+func (nopDialer) DialContext(context.Context, string, string) (netproxy.Conn, error) {
+	return nil, errors.New("nop")
+}
+
+func testConfigJSON(t *testing.T) (cfg Config, b64 string) {
+	t.Helper()
+	priv, err := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	if err != nil {
+		t.Fatal(err)
+	}
+	der, err := x509.MarshalECPrivateKey(priv)
+	if err != nil {
+		t.Fatal(err)
+	}
+	pubDER, err := x509.MarshalPKIXPublicKey(&priv.PublicKey)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg = Config{
+		PrivateKey:     base64.StdEncoding.EncodeToString(der),
+		EndpointPubKey: string(pem.EncodeToMemory(&pem.Block{Type: "PUBLIC KEY", Bytes: pubDER})),
+		EndpointV4:     "162.159.198.2",
+		EndpointV6:     "2606:4700:100::2",
+		ID:             "test-id",
+	}
+	raw, err := json.Marshal(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return cfg, base64.RawURLEncoding.EncodeToString(raw)
+}
+
+func testLink(t *testing.T, query, fragment string) string {
+	t.Helper()
+	_, b64 := testConfigJSON(t)
+	link := "masque://?cfg=" + b64 + query
+	if fragment != "" {
+		link += "#" + fragment
+	}
+	return link
+}
+
+func TestParseMasqueURLDefaults(t *testing.T) {
+	link := testLink(t, "", "WARP")
+	m, err := ParseMasqueURL(link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.name != "WARP" {
+		t.Errorf("name = %q, want WARP", m.name)
+	}
+	if m.endpoint != "162.159.198.2:443" {
+		t.Errorf("endpoint = %q, want 162.159.198.2:443", m.endpoint)
+	}
+	if m.sni != DefaultSNI {
+		t.Errorf("sni = %q, want %q", m.sni, DefaultSNI)
+	}
+	if m.insecure {
+		t.Error("insecure = true, want false")
+	}
+}
+
+func TestParseMasqueURLEndpointPrecedence(t *testing.T) {
+	// endpoint= query wins over the link host.
+	_, b64 := testConfigJSON(t)
+	link := "masque://203.0.113.7?cfg=" + b64 + "&endpoint=198.51.100.9&port=8443"
+	m, err := ParseMasqueURL(link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.endpoint != "198.51.100.9:8443" {
+		t.Errorf("endpoint = %q, want 198.51.100.9:8443", m.endpoint)
+	}
+
+	// Host wins over the embedded config endpoint.
+	link = "masque://198.51.100.9?cfg=" + b64 + "&port=2408"
+	m, err = ParseMasqueURL(link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.endpoint != "198.51.100.9:2408" {
+		t.Errorf("endpoint = %q, want 198.51.100.9:2408", m.endpoint)
+	}
+
+	// Host already carrying a port is used verbatim.
+	link = "masque://198.51.100.9:2408?cfg=" + b64 + "&port=443"
+	m, err = ParseMasqueURL(link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.endpoint != "198.51.100.9:2408" {
+		t.Errorf("endpoint = %q, want 198.51.100.9:2408", m.endpoint)
+	}
+}
+
+func TestParseMasqueURLIPv6Fallback(t *testing.T) {
+	link := testLink(t, "&ipv6=1", "")
+	m, err := ParseMasqueURL(link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if m.endpoint != "[2606:4700:100::2]:443" {
+		t.Errorf("endpoint = %q, want [2606:4700:100::2]:443", m.endpoint)
+	}
+}
+
+func TestParseMasqueURLErrors(t *testing.T) {
+	_, b64 := testConfigJSON(t)
+	cases := []struct {
+		name string
+		link string
+	}{
+		{"scheme", "socks5://127.0.0.1:1080"},
+		{"missing cfg", "masque://1.2.3.4"},
+		{"bad b64", "masque://?cfg=@@@not-base64@@@"},
+		{"bad json", "masque://?cfg=" + base64.RawURLEncoding.EncodeToString([]byte("{"))},
+		{"bad port", "masque://?cfg=" + b64 + "&port=0"},
+		{"bad port nan", "masque://?cfg=" + b64 + "&port=abc"},
+	}
+	for _, tc := range cases {
+		if _, err := ParseMasqueURL(tc.link, false); err == nil {
+			t.Errorf("%s: expected error, got nil", tc.name)
+		}
+	}
+
+	// ipv6=1 without an endpoint_v6 in config.
+	cfg, b64 := testConfigJSON(t)
+	cfg.EndpointV6 = ""
+	raw, _ := json.Marshal(cfg)
+	link := "masque://?cfg=" + base64.RawURLEncoding.EncodeToString(raw) + "&ipv6=1"
+	if _, err := ParseMasqueURL(link, false); err == nil {
+		t.Error("ipv6 without endpoint_v6: expected error, got nil")
+	}
+}
+
+func TestDialContextRejectsUDPWithoutNetwork(t *testing.T) {
+	link := testLink(t, "", "")
+	m, err := ParseMasqueURL(link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := m.DialContext(context.Background(), "udp", "1.1.1.1:53"); !errors.Is(err, netproxy.UnsupportedTunnelTypeError) {
+		t.Errorf("udp dial error = %v, want UnsupportedTunnelTypeError", err)
+	}
+}
+
+func TestDialContextParsesMagicNetwork(t *testing.T) {
+	link := testLink(t, "", "")
+	m, err := ParseMasqueURL(link, false)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// dae encodes SO_MARK/MPTCP into the network string; the encoded udp
+	// form must still be rejected as unsupported, not fall through.
+	encodedUDP := netproxy.MagicNetwork{Network: "udp"}.Encode()
+	if _, err := m.DialContext(context.Background(), encodedUDP, "1.1.1.1:53"); !errors.Is(err, netproxy.UnsupportedTunnelTypeError) {
+		t.Errorf("encoded udp dial error = %v, want UnsupportedTunnelTypeError", err)
+	}
+	// a truncated magic encoding surfaces the parse error instead.
+	if _, err := m.DialContext(context.Background(), "\x00\x03", "1.1.1.1:53"); err == nil || errors.Is(err, netproxy.UnsupportedTunnelTypeError) {
+		t.Errorf("truncated magic dial error = %v, want parse error", err)
+	}
+}
+
+func TestNewMasqueRegistersScheme(t *testing.T) {
+	link := testLink(t, "&port=2408", "MyNode")
+	d, prop, err := dialer.NewNetproxyDialerFromLink(nopDialer{}, &dialer.ExtraOption{}, link)
+	if err != nil {
+		t.Fatal(err)
+	}
+	m, ok := d.(*Masque)
+	if !ok {
+		t.Fatalf("dialer type = %T, want *Masque", d)
+	}
+	defer m.Close()
+	if prop.Protocol != "masque" {
+		t.Errorf("Protocol = %q, want masque", prop.Protocol)
+	}
+	if prop.Name != "MyNode" {
+		t.Errorf("Name = %q, want MyNode", prop.Name)
+	}
+	if prop.Address != "162.159.198.2:2408" {
+		t.Errorf("Address = %q, want 162.159.198.2:2408", prop.Address)
+	}
+	if prop.Link != link {
+		t.Errorf("Link = %q, want original link", prop.Link)
+	}
+	if !strings.HasPrefix(prop.Link, "masque://") {
+		t.Errorf("Link = %q, want masque:// prefix", prop.Link)
+	}
+}
