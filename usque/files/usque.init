#!/bin/sh /etc/rc.common
# WARP MASQUE tunnel as a local SOCKS5 proxy. procd respawn covers crashes;
# /usr/share/luci-app-daede/usque.sh watchdog (cron) covers hung tunnels.

USE_PROCD=1
START=99

CONF="usque"
PROG="/usr/bin/usque"
CFGFILE="/etc/usque/config.json"

log() {
	logger -t usque-init "$@"
}

start_service() {
	config_load "$CONF"

	local enabled
	config_get_bool enabled "config" "enabled" "0"
	if [ "$enabled" -ne 1 ]; then
		log "start: disabled in UCI, exit"
		return 1
	fi

	if [ ! -s "$CFGFILE" ]; then
		log "start: $CFGFILE missing or empty; upload a config.json first"
		return 1
	fi

	local bind port
	config_get bind "config" "bind" "127.0.0.1"
	config_get port "config" "port" "1080"

	log "start: socks ${bind}:${port}"

	procd_open_instance "$CONF"
	procd_set_param command "$PROG" -c "$CFGFILE" socks -b "$bind" -p "$port"
	procd_set_param file "$CFGFILE"
	procd_set_param file "/etc/config/usque"
	# Crash recovery: reset the short-lived exit counter after an hour of
	# stable runtime, else retry after 5s and give up after 10 quick failures.
	procd_set_param respawn 3600 5 10
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	log "stop: socks proxy stopped"
}

service_triggers() {
	procd_add_reload_trigger "$CONF"
}
